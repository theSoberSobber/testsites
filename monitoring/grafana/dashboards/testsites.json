{
 "uid": "testsites",
 "title": "Test sites",
 "tags": [
  "testsites"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 2,
 "refresh": "30s",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Requests (range)",
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(testsites_requests_total[$__range]))"
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Unique IPs (5m)",
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 6,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "testsites_unique_ips_5m"
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Disk free",
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 12,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 10
       },
       {
        "color": "green",
        "value": 20
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "testsites_disk_free_pct"
    }
   ]
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Access log size",
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 18,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "testsites_log_bytes"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Requests / second by site",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "fillOpacity": 20,
      "lineWidth": 1,
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (site) (rate(testsites_requests_total[1m]))",
     "legendFormat": "{{site}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Responses by status",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "fillOpacity": 20,
      "lineWidth": 1,
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status) (rate(testsites_responses_total[1m]))",
     "legendFormat": "{{status}}"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Egress",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 13
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "Bps",
     "custom": {
      "fillOpacity": 15,
      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (site) (rate(testsites_response_bytes_total[1m]))",
     "legendFormat": "{{site}}"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Upload bytes/s",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 13
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "Bps",
     "custom": {
      "fillOpacity": 15,
      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (site) (rate(testsites_upload_bytes_total[1m]))",
     "legendFormat": "{{site}}"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Response time p50 / p95",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 21
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "fillOpacity": 10,
      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(testsites_request_duration_seconds_bucket[5m])))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(testsites_request_duration_seconds_bucket[5m])))",
     "legendFormat": "p95"
    }
   ]
  },
  {
   "id": 10,
   "type": "table",
   "title": "Requests by site (range)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 21
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "showHeader": true,
    "sortBy": [
     {
      "displayName": "Value",
      "desc": true
     }
    ]
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (site) (increase(testsites_requests_total[$__range]))",
     "format": "table",
     "instant": true
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "site": "site",
       "Value": "requests"
      }
     }
    }
   ]
  },
  {
   "id": 11,
   "type": "logs",
   "title": "Access log",
   "gridPos": {
    "h": 10,
    "w": 24,
    "x": 0,
    "y": 29
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "enableLogDetails": true
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{job=\"access\"}"
    }
   ]
  },
  {
   "id": 12,
   "type": "stat",
   "title": "Host CPU busy",
   "gridPos": {
    "h": 5,
    "w": 8,
    "x": 0,
    "y": 39
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 60
       },
       {
        "color": "red",
        "value": 85
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    },
    "colorMode": "background",
    "graphMode": "area"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[2m])) * 100)"
    }
   ]
  },
  {
   "id": 13,
   "type": "stat",
   "title": "Host memory used",
   "gridPos": {
    "h": 5,
    "w": 8,
    "x": 8,
    "y": 39
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 75
       },
       {
        "color": "red",
        "value": 90
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    },
    "colorMode": "background",
    "graphMode": "area"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)"
    }
   ]
  },
  {
   "id": 14,
   "type": "stat",
   "title": "Host load (1m)",
   "gridPos": {
    "h": 5,
    "w": 8,
    "x": 16,
    "y": 39
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "node_load1"
    }
   ]
  },
  {
   "id": 15,
   "type": "row",
   "title": "External probes (GitHub Actions)",
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 44
   },
   "collapsed": false,
   "panels": []
  },
  {
   "id": 16,
   "type": "stat",
   "title": "Last probe age",
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 0,
    "y": 45
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "description": "Seconds since the newest GHA probe hit the app. 15 min cadence, so stale means the tunnel or the runner is broken. This is the only signal that survives a dead tunnel.",
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "time() - max(testsites_probe_last_seen_timestamp_seconds{probe=\"gha-cron\"})"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 1500
       },
       {
        "color": "red",
        "value": 2100
       }
      ]
     }
    }
   }
  },
  {
   "id": 17,
   "type": "stat",
   "title": "Probe success (1h)",
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 6,
    "y": 45
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "description": "",
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 * sum(increase(testsites_probe_responses_total{probe=\"gha-cron\",status=~\"2..\"}[1h])) / clamp_min(sum(increase(testsites_probe_responses_total{probe=\"gha-cron\"}[1h])), 1)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "yellow",
        "value": 90
       },
       {
        "color": "green",
        "value": 99
       }
      ]
     }
    }
   }
  },
  {
   "id": 18,
   "type": "stat",
   "title": "Probes (1h)",
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 12,
    "y": 45
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "description": "",
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(testsites_probe_requests_total{probe=\"gha-cron\"}[1h]))"
    }
   ],
   "fieldConfig": {
    "defaults": {}
   }
  },
  {
   "id": 19,
   "type": "stat",
   "title": "Probe upload (1h)",
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 18,
    "y": 45
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "description": "",
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(testsites_probe_upload_bytes_total{probe=\"gha-cron\"}[1h]))"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    }
   }
  },
  {
   "id": 20,
   "type": "timeseries",
   "title": "Probe response time",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 50
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "description": "",
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum(rate(testsites_probe_duration_seconds_bucket{probe=\"gha-cron\"}[15m])) by (le))",
     "legendFormat": "p95"
    },
    {
     "refId": "B",
     "expr": "max(testsites_probe_duration_seconds_sum{probe=\"gha-cron\"} / testsites_probe_duration_seconds_count{probe=\"gha-cron\"})",
     "legendFormat": "mean"
    }
   ]
  },
  {
   "id": 21,
   "type": "timeseries",
   "title": "Probe results by status",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 50
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "description": "",
   "fieldConfig": {
    "defaults": {}
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status) (rate(testsites_probe_responses_total{probe=\"gha-cron\"}[15m]))",
     "legendFormat": "{{status}}"
    }
   ]
  }
 ]
}